# Copy this file to .env for local development (never commit the real .env).
# In production, set these as real environment variables on your host instead
# of using a .env file.

# Flask environment: development | production | testing
FLASK_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The super admin account is provisioned automatically on first startup
# from these three variables (idempotent -- re-running never overwrites an
# existing password). Every other user registers themselves at /register
# and is approved from /admin -- see README's "Accounts & roles". The
# password is hashed at startup and never written to disk in plaintext.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Optional tuning (defaults shown) ---
# RECOGNITION_CONFIDENCE_THRESHOLD=0.5
# FACE_DETECTION_CONFIDENCE=0.5
# CAPTURE_IMAGE_COUNT=50
# RECOGNITION_POLL_INTERVAL_MS=1500
# MIN_TRAINING_IMAGES_PER_STUDENT=5
# MIN_TRAINING_STUDENTS=2
# SESSION_LIFETIME_HOURS=12
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=60

# --- Optional path overrides (defaults are relative to the project dir; only
# used when DATABASE_URL below is NOT set -- see the next section) ---
# DATABASE_PATH=./attendance.db
# DATASET_DIR=./dataset
# MODEL_PATH=./model.pkl
# MODEL_META_PATH=./model_meta.json
# TRAIN_STATUS_PATH=./train_status.json
# LOG_PATH=./app.log

# --- Production storage on hosts with an ephemeral filesystem ---
# Leave this UNSET for local development -- SQLite + local files above is
# simpler and needs no setup. Set it when deploying somewhere the local
# filesystem doesn't survive a restart/redeploy (e.g. Render's free web
# service): the app then stores everything (students, attendance, captured
# face images, and the trained model) in this Postgres database instead,
# via db.py/storage.py. A free provider like Neon (neon.tech) works well
# here and needs no credit card -- see README's "Deploying for free"
# section for the full walkthrough.
# DATABASE_URL=postgresql://user:password@host/dbname
